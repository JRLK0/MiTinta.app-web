{
  "name": "mitinta-lorcana-mcp",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "types": "wrangler types",
    "build": "tsc --noEmit && esbuild src/index.ts --bundle --format=esm --platform=neutral --main-fields=module,main --conditions=workerd,worker,browser --external:cloudflare:workers --outfile=dist/worker.js --minify",
    "test": "npm run build && node tests/runtime.mjs",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.2.4",
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261027.1",
    "esbuild": "0.28.2",
    "miniflare": "5.20261023.1-beta",
    "typescript": "7.0.2",
    "wrangler": "4.154.0"
  },
  "overrides": { "workerd": "1.20261106.1" }
}
